---
import { getBookings, getWorkers } from '@lib/db';
import { getCsrfCookieName } from '@lib/auth';
import { services } from '@lib/site';

const csrfCookieName = getCsrfCookieName();
const csrfToken =
  (Astro.props as { csrfToken?: string }).csrfToken ??
  Astro.cookies.get(csrfCookieName)?.value ??
  crypto.randomUUID();
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '1x00000000000000000000AA';
const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(new Date());
const workers = await getWorkers();
const bookings = await getBookings();
---

<section class="booking-shell shell" data-booking-app data-today-iso={todayIso} data-bookings={JSON.stringify(bookings)}>
  <header class="step-header">
    <p class="eyebrow">Reserva online</p>
    <h1 class="section-title">Reserva nuestro servicio y deja preparada tu visita</h1>
    <div class="stepper">
      <div class="stepper-item is-active" data-step-indicator="1"><strong>01</strong><span>Servicio</span></div>
      <div class="stepper-item" data-step-indicator="2"><strong>02</strong><span>Dia y hora</span></div>
      <div class="stepper-item" data-step-indicator="3"><strong>03</strong><span>Barbero</span></div>
      <div class="stepper-item" data-step-indicator="4"><strong>04</strong><span>Confirmacion</span></div>
    </div>
  </header>

  <div class="booking-top-actions">
    <button class="btn btn-secondary" type="button" data-show-manage>Gestionar citas</button>
  </div>

  <section class="appointments-section surface" data-manage-section hidden>
    <div class="appointments-head">
      <div>
        <p class="eyebrow">Tus citas</p>
        <h2 class="section-title">Consulta, cambia o cancela las citas que ya tienes con nosotros</h2>
      </div>
      <p class="copy">Usa tu nombre y tu telefono para ver tus reservas guardadas y seguir gestionandolas desde aqui.</p>
    </div>

    <form class="appointments-lookup" data-lookup-form>
      <input type="hidden" name="csrfToken" value={csrfToken} />
      <label class="field-label">
        Nombre
        <input class="field" name="name" type="text" maxlength="80" autocomplete="name" required />
      </label>
      <label class="field-label">
        Telefono
        <input class="field" name="phone" type="tel" maxlength="20" autocomplete="tel" required />
      </label>
      <button class="btn btn-primary" type="submit">Ver mis citas</button>
    </form>

    <div class="form-status" data-lookup-status hidden></div>
    <div class="appointments-list" data-appointments-list></div>
  </section>

  <div class="booking-grid">
    <div class="booking-panel surface">
      <section class="booking-step is-active" data-step="1">
        <p class="eyebrow">Servicio</p>
        <h2 class="section-title">Elige uno de nuestros servicios</h2>
        <div class="booking-card-grid" style="margin-top: 26px;">
          {services.map((service) => (
            <button
              type="button"
              class="booking-choice square-card-mobile"
              data-service-card
              data-service-name={service.name}
              data-service-price={service.price}
              data-service-duration={service.duration}
            >
              <div class="booking-choice-top">
                <div>
                  <h3>{service.name}</h3>
                  <p>Precio claro de nuestros servicios.</p>
                  <span>{service.duration}</span>
                </div>
                <strong class="booking-choice-price">{service.price}</strong>
              </div>
            </button>
          ))}
        </div>
      </section>

      <section class="booking-step" data-step="2">
        <div class="booking-calendar-layout">
          <div>
            <p class="eyebrow">Dia y hora</p>
            <h2 class="section-title">Encuentra el hueco que mejor te venga</h2>
            <div class="period-row" style="margin-top: 22px;">
              <button class="period-btn is-active" type="button" data-period="manana">Manana</button>
              <button class="period-btn" type="button" data-period="tarde">Tarde</button>
            </div>
            <div class="calendar-header">
              <strong data-month-label style="text-transform: capitalize;"></strong>
              <div class="calendar-nav">
                <button type="button" data-month-prev aria-label="Mes anterior">&#8249;</button>
                <button type="button" data-month-next aria-label="Mes siguiente">&#8250;</button>
              </div>
            </div>
            <div class="calendar-weekdays">
              <span>Lun.</span>
              <span>Mar.</span>
              <span>Mie.</span>
              <span>Jue.</span>
              <span>Vie.</span>
              <span>Sab.</span>
              <span>Dom.</span>
            </div>
            <div class="calendar-grid" data-calendar></div>
            <p class="muted-note" style="margin-top: 16px;">No abrimos reservas en domingo ni en fechas anteriores a hoy.</p>
          </div>
          <div>
            <p class="eyebrow">Horas disponibles</p>
            <h2 class="section-title">Selecciona una hora</h2>
            <div class="time-grid" style="margin-top: 22px;" data-time-grid></div>
            <p class="muted-note" style="margin-top: 16px;" data-time-availability-note>Primero elige un dia para ver las horas disponibles.</p>
          </div>
        </div>
      </section>

      <section class="booking-step" data-step="3">
        <p class="eyebrow">Quien te atiende</p>
        <h2 class="section-title">Elige la persona disponible para esa hora</h2>
        <div class="booking-card-grid" style="margin-top: 26px;" data-barber-grid>
          {workers.map((worker) => (
            <button
              type="button"
              class="booking-choice barber-choice square-card-mobile"
              data-barber-card
              data-barber-value={worker.value}
              data-barber-name={worker.name}
            >
              <div class="barber-avatar">{worker.name.split(' ').map((item) => item[0]).slice(0, 2).join('')}</div>
              <div>
                <h3>{worker.name}</h3>
                <p data-barber-note>Elige una hora para ver su disponibilidad.</p>
              </div>
            </button>
          ))}
        </div>
      </section>

      <section class="booking-step" data-step="4">
        <p class="eyebrow" data-form-kicker>Confirmacion</p>
        <h2 class="section-title" data-form-title>Confirma tu cita con nosotros</h2>
        <p class="copy" style="margin-top: 14px;" data-form-copy>
          Te pedimos solo lo necesario para guardar la cita y poder localizarte.
        </p>

        <div class="form-status" data-booking-status hidden></div>

        <form id="booking-form" style="margin-top: 28px; display: grid; gap: 18px;">
          <input type="hidden" name="csrfToken" value={csrfToken} />
          <input type="hidden" name="bookingId" data-hidden-booking-id />
          <input type="hidden" name="service" data-hidden-service required />
          <input type="hidden" name="barber" data-hidden-barber required />
          <input type="hidden" name="date" data-hidden-date required />
          <input type="hidden" name="time" data-hidden-time required />

          <div class="field-grid">
            <label class="field-label">
              Nombre
              <input class="field" name="name" type="text" maxlength="80" autocomplete="name" required />
            </label>
            <label class="field-label">
              Telefono
              <input class="field" name="phone" type="tel" maxlength="20" autocomplete="tel" required />
            </label>
          </div>

          <label class="field-label">
            Nota para la cita
            <textarea class="field" name="notes" maxlength="500" placeholder="Si quieres dejarnos una nota corta, escríbela aquí"></textarea>
          </label>

          <div class="captcha-wrap">
            <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark"></div>
          </div>

          <button class="btn btn-primary" type="submit" data-submit-booking style="width: 100%;">Confirmar cita</button>
        </form>
      </section>
    </div>

    <aside class="summary-aside">
      <div class="summary-card surface">
        <p class="eyebrow">Resumen</p>
        <h2 class="section-title" style="font-size: clamp(1.6rem, 2.2vw, 2.1rem); margin-top: 12px;">Así va quedando tu cita</h2>
        <div class="summary-list">
          <div class="summary-list-item"><strong>Servicio:</strong> <span data-summary-service>Pendiente</span></div>
          <div class="summary-list-item"><strong>Persona:</strong> <span data-summary-barber>Pendiente</span></div>
          <div class="summary-list-item"><strong>Día:</strong> <span data-summary-date>Pendiente</span></div>
          <div class="summary-list-item"><strong>Hora:</strong> <span data-summary-time>Pendiente</span></div>
        </div>
        <div style="margin-top: 24px; display: flex; justify-content: space-between; align-items: center; gap: 14px;">
          <span class="eyebrow" style="margin: 0;">Precio de nuestros servicios</span>
          <strong data-summary-price style="font-family: 'Playfair Display', Georgia, serif; font-size: 2rem; color: var(--gold);">0,00 EUR</strong>
        </div>
        <div class="summary-actions">
          <button class="btn btn-primary" type="button" data-next-step disabled>Siguiente paso</button>
          <button class="btn btn-secondary" type="button" data-prev-step style="display: none;">Volver</button>
        </div>
      </div>
    </aside>
  </div>

  <div class="booking-nav surface">
    <button class="btn btn-secondary" type="button" data-nav-prev style="display: none;">Retroceder</button>
    <button class="btn btn-primary" type="button" data-nav-next disabled>Continuar</button>
  </div>

  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
  <script is:inline src="/scripts/booking-form.js"></script>
</section>
