---
import { site } from '@lib/site';
import type { DashboardData } from '@lib/db';

const { dashboard, csrfToken } = Astro.props as {
  dashboard: DashboardData;
  csrfToken: string;
};

const today = new Date();
const monthStart = new Date(today.getFullYear(), today.getMonth(), 1);
const monthEnd = new Date(today.getFullYear(), today.getMonth() + 1, 0);
const startOffset = monthStart.getDay() === 0 ? 6 : monthStart.getDay() - 1;
const monthLabel = new Intl.DateTimeFormat('es-ES', { month: 'long', year: 'numeric' }).format(today);
const todayIso = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(today);
const weekdayLabels = ['Lun', 'Mar', 'Mie', 'Jue', 'Vie', 'Sab', 'Dom'];

const bookingsByDate = new Map<string, DashboardData['bookings']>();
for (const booking of dashboard.bookings) {
  const list = bookingsByDate.get(booking.date) ?? [];
  list.push(booking);
  bookingsByDate.set(booking.date, list);
}

const monthCells: Array<{ date: string | null; day: string; count: number; isToday: boolean }> = [];
for (let index = 0; index < startOffset; index += 1) {
  monthCells.push({ date: null, day: '', count: 0, isToday: false });
}

for (let day = 1; day <= monthEnd.getDate(); day += 1) {
  const dateValue = new Date(today.getFullYear(), today.getMonth(), day, 12);
  const isoValue = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Madrid' }).format(dateValue);
  monthCells.push({
    date: isoValue,
    day: String(day),
    count: (bookingsByDate.get(isoValue) ?? []).length,
    isToday: isoValue === todayIso,
  });
}

const initialAgendaDate = todayIso;
---

<div class="dashboard" data-admin-dashboard data-initial-date={initialAgendaDate} data-csrf-token={csrfToken}>
  <main class="dashboard-main dashboard-main--full">
    <header class="dashboard-header" id="resumen">
      <div class="dashboard-topbar">
        <div>
          <h1 class="dashboard-title">JSanchez Barbershop</h1>
          <p class="dashboard-subtitle">Calle de los Porches, Badajoz</p>
        </div>
        <div class="button-row">
          <a class="btn btn-secondary" href="/">Volver al inicio</a>
          <a class="btn btn-secondary" href="/reservas">Ir a reservas</a>
          <form id="admin-logout-form" action="/api/admin/logout" method="post">
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <button class="btn btn-primary" type="submit">Cerrar sesion</button>
          </form>
        </div>
      </div>
    </header>

    <section class="dashboard-content">
      <div class="calendar-panel" id="calendario">
        <div class="calendar-month-title">
          <div>
            <p class="eyebrow">Calendario mensual</p>
            <h2 class="section-title" style="text-transform: capitalize;">{monthLabel}</h2>
          </div>
          <span class="status-pill pending" data-admin-total>{dashboard.bookings.length} reservas registradas</span>
        </div>

        <div class="admin-calendar">
          {weekdayLabels.map((label) => <div class="admin-calendar-head">{label}</div>)}
          {monthCells.map((cell) => (
            <button
              type="button"
              class:list={[
                'admin-calendar-day',
                !cell.date && 'is-empty',
                cell.isToday && 'is-today',
                cell.date === initialAgendaDate && 'is-selected',
              ]}
              disabled={!cell.date}
              data-admin-date={cell.date ?? ''}
            >
              {cell.date ? (
                <div class="admin-calendar-day-inner">
                  <strong>{cell.day}</strong>
                  {cell.count > 0 && (
                    <span class="admin-calendar-count" data-admin-count>
                      {cell.count} {cell.count === 1 ? 'cita' : 'citas'}
                    </span>
                  )}
                </div>
              ) : null}
            </button>
          ))}
        </div>
      </div>

      <aside class="agenda-panel" id="trabajadores">
        <details class="agenda-details" data-agenda-details open>
          <summary class="agenda-summary">
            <div>
              <p class="eyebrow">Reservas del dia</p>
              <h2 class="section-title" data-agenda-title>Reservas guardadas</h2>
            </div>
            <span class="status-pill pending" data-agenda-count>0 citas</span>
          </summary>

          <div class="agenda-list" data-agenda-list></div>
        </details>

        <div class="soft-surface booking-panel" style="margin-top: 24px;">
          <p class="eyebrow">Personas reservables</p>
          <form id="worker-create-form" style="display: grid; gap: 12px; margin-top: 16px;">
            <input type="hidden" name="csrfToken" value={csrfToken} />
            <label class="field-label">
              Nombre
              <input class="field" name="name" type="text" maxlength="80" required />
            </label>
            <button class="btn btn-primary" type="submit" style="width: 100%;">Anadir persona</button>
          </form>

          <div style="display: grid; gap: 10px; margin-top: 18px;" data-worker-list>
            {dashboard.workers.map((worker) => (
              <article class="soft-surface" style="padding: 14px;">
                <div style="display: flex; justify-content: space-between; gap: 12px; align-items: start;">
                  <div>
                    <strong>{worker.name}</strong>
                  </div>
                  <button class="danger-btn" type="button" data-remove-worker={worker.id}>Quitar</button>
                </div>
              </article>
            ))}
          </div>

          <p class="muted-note" style="margin-top: 14px;">
            Lo que anadas o quites aqui se refleja directamente en la pagina de reservas.
          </p>
          <p class="muted-note" style="margin-top: 14px;">Contacto del negocio: {site.phoneDisplay}</p>
        </div>
      </aside>
    </section>
  </main>

  <script is:inline type="application/json" id="admin-bookings-json" set:html={JSON.stringify(dashboard.bookings)}></script>
  <script is:inline src="/scripts/admin-dashboard.js"></script>
</div>
